# Copy to .env and run `python scripts/bootstrap_lab.py` to create local-only secrets.
PS033_DOMAIN=ps033.test
PS033_DNS_RESOLVER=127.0.0.1
PS033_DNS_PORT=5353
PS033_DNS_TIMEOUT=2.0
PS033_DNS_REQUIRE_AD=true
PS033_TLS_CA=config/certs/ca.crt
PS033_TOKEN_POLICIES_JSON={}
PS033_ALLOWED_IPS=127.0.0.1,::1
PS033_ALLOWED_TARGETS=lab-target.ps033.test
PS033_LOG_LEVEL=INFO
PS033_HTTP_TIMEOUT=5.0
PS033_CACHE_TTL_CAP=60
PS033_BEARER_TOKEN=
